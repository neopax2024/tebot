# ────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Telegram Bot ──────────────────────────────────────────────────────────
# Get from @BotFather → /newbot
BOT_TOKEN=1234567890:ABCdefGhIjKlMnOpQrStUvWxYz

# Public HTTPS URL where the webhook is reachable (optional — leave blank for polling)
WEBHOOK_URL=https://your-domain.com
WEBHOOK_PATH=/webhook

# Public URL of the FastAPI server (used to generate short links for dynamic QR)
BASE_URL=https://your-domain.com
SHORT_URL_PREFIX=https://your-domain.com/r/

# Public URL of the Telegram Mini App (served from /app/)
WEBAPP_URL=https://your-domain.com/app

# ── Database ──────────────────────────────────────────────────────────────
# PostgreSQL (or Supabase connection string)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/telegram_bot
POSTGRES_PASSWORD=password

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── FastAPI ───────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
# Used to protect admin API endpoints — change this!
API_SECRET_KEY=change-me-in-production

# ── Search APIs ───────────────────────────────────────────────────────────
# Google Custom Search API (optional)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI (optional — fallback if Google not configured)
SERP_API_KEY=

# ── Security ──────────────────────────────────────────────────────────────
# VirusTotal URL safety check (optional)
VIRUSTOTAL_API_KEY=

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your@gmail.com

# ── Stripe ────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Admin ─────────────────────────────────────────────────────────────────
# Comma-separated Telegram user IDs with admin access
ADMIN_IDS=123456789,987654321

# ── Limits ────────────────────────────────────────────────────────────────
FREE_DAILY_SCANS=20
FREE_DAILY_GENERATIONS=10
FREE_DYNAMIC_QR_LIMIT=3

# Premium pricing
PREMIUM_PRICE_STARS=500
PREMIUM_PRICE_USD=4.99

# ── Storage ───────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/tgbot_uploads
GENERATED_DIR=/tmp/tgbot_generated

# ── Logging ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
